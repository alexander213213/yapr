# Copy to .env for local dev (never commit .env).
# Server endpoint (TLS only — the server is fail-closed, no plaintext mode).
# Packaged default is the staging relay; uncomment to aim at localhost instead.
# HOST=127.0.0.1
# PORT=9000
# TLS trust: staging default skips verification (says so on every launch).
# Point at the server's CA/certificate to verify instead:
# Copy yapr-server's certs/dev-cert.pem next to this file (or point at it) and keep this line.
# YAPR_CA_FILE=./certs/dev-cert.pem
# Explicit insecure escape hatch (equivalent to the staging default).
# YAPR_INSECURE=1
# Local data override (default: OS data dir, see docs/STORAGE.md).
# YAPR_DATA_DIR=
