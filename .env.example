# Copy to .env for local dev (never commit .env).
# Server endpoint (TLS only — the server is fail-closed, no plaintext mode).
HOST=127.0.0.1
PORT=9000
# TLS trust: the server's CA/certificate for self-signed dev setups.
# Copy yapr-server's certs/dev-cert.pem next to this file (or point at it) and keep this line.
# YAPR_CA_FILE=./certs/dev-cert.pem
# Development only: accept any certificate. NEVER enable outside localhost dev.
# YAPR_INSECURE=1
# Local data override (default: OS data dir, see docs/STORAGE.md).
# YAPR_DATA_DIR=
